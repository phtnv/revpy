{
    // Golden request bodies for all three backends.
    //
    // These pin the exact dict each backend's build_body() produces, so a change to
    // the request builders has to be deliberate: every body here must come out
    // byte-identical, or the test says which key moved.
    // No network is involved; only the request builders run.
    //
    // 'inputs' holds prepared chat requests (what server.prepare_chat_request returns)
    // together with the request each backend must build from them. The two OpenAI-style
    // endpoints share one message list under different keys -- 'messages' on chat,
    // 'input' on responses -- so the test injects it under the right one rather than
    // repeating it in every expected body. The Anthropic body is shaped differently
    // enough to get its own 'anthropic' entry, which a case may override.
    //
    // A case's 'builder' picks both the backend module and the wire protocol its
    // provider is declared under. 'provider' overrides the defaults in make_provider()
    // and 'cfg' overrides the test config.

    inputs: {
        basic: {
            prepared: {
                messages: [
                    { role: "user"     , content: "Hello."    },
                    { role: "assistant", content: "Hi there." },
                    { role: "user"     , content: "Continue." },
                ],
                system_segments      : ["Core definitions.", "Advanced prompt."],
                system_summary_text  : "",
                lorebook_at_end_text : "",
                max_tokens           : 256,
            },
            messages: [
                { role: "system"   , content: "Core definitions.\n\nAdvanced prompt." },
                { role: "user"     , content: "Hello."    },
                { role: "assistant", content: "Hi there." },
                { role: "user"     , content: "Continue." },
            ],
            anthropic: {
                system: [
                    { type: "text", text: "Core definitions." },
                    { type: "text", text: "Advanced prompt."  },
                ],
                messages: [
                    { role: "user"     , content: "Hello."    },
                    { role: "assistant", content: "Hi there." },
                    { role: "user"     , content: "Continue." },
                ],
            },
        },

        // Exercises the rest of build_message_list(): blank system segments are dropped,
        // the summary is appended to the system message, and the moved lorebook becomes
        // a trailing system message. All three are stripped.
        full: {
            prepared: {
                messages: [
                    { role: "user"     , content: "Hello."    },
                    { role: "assistant", content: "Hi there." },
                ],
                system_segments      : ["Core definitions.", "   ", "Advanced prompt."],
                system_summary_text  : "  Previously: they met.  ",
                lorebook_at_end_text : "  <lorebook>Entry.</lorebook>  ",
                max_tokens           : 512,
            },
            messages: [
                { role: "system"   , content: "Core definitions.\n\nAdvanced prompt.\n\nPreviously: they met." },
                { role: "user"     , content: "Hello."    },
                { role: "assistant", content: "Hi there." },
                { role: "system"   , content: "<lorebook>Entry.</lorebook>" },
            ],
            // The Anthropic body handles the same three the other way round: every system
            // segment stays its own block (blank ones included, unlike the OpenAI-style
            // join), the summary becomes a trailing block, and the moved lorebook is
            // appended to the last user message as an OOC update -- which is what a model
            // below 4.8 gets, since those take no mid-conversation system message.
            anthropic: {
                system: [
                    { type: "text", text: "Core definitions."     },
                    { type: "text", text: "   "                   },
                    { type: "text", text: "Advanced prompt."      },
                    { type: "text", text: "Previously: they met." },
                ],
                messages: [
                    { role: "user"     , content: "Hello.\n\n<OOC>\nGameMaster lore update:\n\n<lorebook>Entry.</lorebook>\n</OOC>" },
                    { role: "assistant", content: "Hi there." },
                ],
            },
        },
    },

    cases: [
        {
            name    : "claude messages: plain body",
            builder : "messages",
            backend : "claude",
            model   : "claude-test-model",
            input   : "basic",
            expected: {
                model      : "claude-test-model",
                max_tokens : 256,
            },
        },

        {
            // The lorebook relocation and the summary block, plus sampling. top_k is an
            // Anthropic-only parameter with no equivalent on the other two endpoints.
            name    : "claude messages: moved lorebook + sampling",
            builder : "messages",
            backend : "claude",
            model   : "claude-test-model",
            input   : "full",
            cfg     : {
                send_temperature : true,
                temperature      : 0.7,
                send_top_p       : true,
                top_p            : 0.99,
                send_top_k       : true,
                top_k            : 75,
            },
            expected: {
                model       : "claude-test-model",
                max_tokens  : 512,
                temperature : 0.7,
                top_p       : 0.99,
                top_k       : 75,
            },
        },

        {
            // Adaptive thinking sends the effort in output_config rather than a budget.
            // EXTRA_BODY cannot be merged into an SDK call, so it rides along as its own
            // keyword argument and the SDK forwards it.
            name    : "claude messages: adaptive thinking + EXTRA_BODY",
            builder : "messages",
            backend : "claude",
            model   : "claude-test-model",
            input   : "basic",
            provider: {
                extra_body: { custom_field: 1 },
            },
            cfg     : {
                thinking_enabled : true,
                use_adaptive     : true,
                thinking_effort  : "high",
            },
            expected: {
                model         : "claude-test-model",
                max_tokens    : 256,
                thinking      : { type: "adaptive", display: "summarized" },
                output_config : { effort: "high" },
                extra_body    : { custom_field: 1 },
            },
        },

        {
            // Budget thinking, and the explicit cache markers no other backend has: one
            // per system block, one at the first message and one at the third from end.
            name    : "claude messages: budget thinking + cache markers",
            builder : "messages",
            backend : "claude",
            model   : "claude-test-model",
            input   : "basic",
            cfg     : {
                thinking_enabled : true,
                use_adaptive     : false,
                thinking_budget  : 2048,
                cache_en         : true,
                cache_system     : true,
                cache_system_ttl : "1h",
                cache_manual_msg : 1,
                cache_manual_ttl : "1h",
                cache_auto_msg   : 3,
                cache_auto_ttl   : "5m",
            },
            expected: {
                model      : "claude-test-model",
                max_tokens : 256,
                thinking   : { type: "enabled", budget_tokens: 2048 },
                system     : [
                    { type: "text", text: "Core definitions.", cache_control: { type: "ephemeral", ttl: "1h" } },
                    { type: "text", text: "Advanced prompt." , cache_control: { type: "ephemeral", ttl: "1h" } },
                ],
                messages   : [
                    // The manual marker lands on the first message, the auto marker three
                    // from the end -- the same message here, and the later write wins.
                    { role: "user"     , content: [{ type: "text", text: "Hello.", cache_control: { type: "ephemeral" } }] },
                    { role: "assistant", content: "Hi there." },
                    { role: "user"     , content: "Continue." },
                ],
            },
        },

        {
            name    : "glm-5.2 chat: thinking dialect + sampling",
            builder : "chat",
            backend : "glm",
            model   : "glm-5.2",
            input   : "basic",
            cfg     : {
                thinking_enabled : true,
                thinking_effort  : "high",
                send_temperature : true,
                temperature      : 0.7,
                send_top_p       : true,
                top_p            : 0.9,
            },
            expected: {
                model            : "glm-5.2",
                max_tokens       : 256,
                temperature      : 0.7,
                top_p            : 0.9,
                thinking         : { type: "enabled" },
                reasoning_effort : "high",
            },
        },

        {
            // EXTRA_BODY is merged after the dialect, so it overrides it. kimi-k3 would
            // send reasoning_effort 'max' for the xhigh setting; the override wins.
            name    : "kimi-k3 chat: EXTRA_BODY overrides the dialect",
            builder : "chat",
            backend : "kimi",
            model   : "kimi-k3",
            input   : "full",
            provider: {
                extra_body: { reasoning_effort: "low", custom_field: 1 },
            },
            cfg     : {
                thinking_enabled : true,
                thinking_effort  : "xhigh",
            },
            expected: {
                model            : "kimi-k3",
                max_tokens       : 512,
                reasoning_effort : "low",
                custom_field     : 1,
            },
        },

        {
            // aion-2.0 is the only Aion model taking reasoning_effort, and 'none' is
            // how its dialect spells thinking off.
            name    : "aion-2.0 chat: thinking disabled",
            builder : "chat",
            backend : "aion",
            model   : "aion-2.0",
            input   : "basic",
            cfg     : {
                thinking_enabled : false,
                thinking_effort  : "high",
            },
            expected: {
                model            : "aion-2.0",
                max_tokens       : 256,
                reasoning_effort : "none",
            },
        },

        {
            // Recognized by the dialect but offering no thinking controls: the empty
            // dialect must add nothing at all, rather than sending a default effort.
            name    : "aion-3.0 chat: recognized, no thinking params",
            builder : "chat",
            backend : "aion",
            model   : "aion-3.0",
            input   : "basic",
            cfg     : {
                thinking_enabled : true,
                thinking_effort  : "high",
            },
            expected: {
                model      : "aion-3.0",
                max_tokens : 256,
            },
        },

        {
            // Reasoning models refuse temperature/top_p, so sampling must be dropped
            // even though both are enabled here.
            name    : "gpt-5.6 responses: max effort, summary, sampling refused",
            builder : "responses",
            backend : "gpt",
            model   : "gpt-5.6",
            input   : "basic",
            cfg     : {
                thinking_enabled : true,
                thinking_effort  : "max",
                send_temperature : true,
                temperature      : 0.7,
                send_top_p       : true,
                top_p            : 0.9,
            },
            expected: {
                model             : "gpt-5.6",
                max_output_tokens : 256,
                store             : false,
                reasoning         : { effort: "max", summary: "auto" },
            },
        },

        {
            // Background mode is a flag on the request and nothing else; it does not
            // touch 'store', which is what keeps the privacy default intact while the
            // response is still recoverable after a cut stream.
            name    : "gpt-5.6 responses: background, store still off",
            builder : "responses",
            backend : "gpt",
            model   : "gpt-5.6",
            input   : "basic",
            provider: {
                background : true,
            },
            cfg     : {
                thinking_enabled : true,
                thinking_effort  : "high",
            },
            expected: {
                model             : "gpt-5.6",
                max_output_tokens : 256,
                store             : false,
                background        : true,
                reasoning         : { effort: "high", summary: "auto" },
            },
        },

        {
            // gpt-5.1 tops out at 'high' and takes 'none' as its off switch. No summary
            // is asked for while thinking is off.
            name    : "gpt-5.1 responses: thinking off, store on",
            builder : "responses",
            backend : "gpt",
            model   : "gpt-5.1",
            input   : "basic",
            provider: {
                store : true,
            },
            cfg     : {
                thinking_enabled : false,
                thinking_effort  : "high",
            },
            expected: {
                model             : "gpt-5.1",
                max_output_tokens : 256,
                store             : true,
                reasoning         : { effort: "none" },
            },
        },

        {
            // The o-series ladder on /responses stops at 'high', so xhigh folds down to
            // it. REASONING_SUMMARY=none drops the summary while thinking stays on.
            name    : "o3 responses: xhigh folds to high, summary off",
            builder : "responses",
            backend : "gpt",
            model   : "o3",
            input   : "basic",
            provider: {
                reasoning_summary : "none",
            },
            cfg     : {
                thinking_enabled : true,
                thinking_effort  : "xhigh",
            },
            expected: {
                model             : "o3",
                max_output_tokens : 256,
                store             : false,
                reasoning         : { effort: "high" },
            },
        },
    ],
}
